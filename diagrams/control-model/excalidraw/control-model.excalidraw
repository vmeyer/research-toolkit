    { "type": "text", "id": "b_title", "x": 60, "y": 40, "width": 900, "height": 36, "text": "The Evidence Contract & Control Dials", "originalText": "The Evidence Contract & Control Dials", "fontSize": 28, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 201001, "version": 1, "versionNonce": 201002, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
    { "type": "text", "id": "b_sub", "x": 60, "y": 82, "width": 900, "height": 22, "text": "What every research step emits — and how it is checked before anything ships", "originalText": "What every research step emits — and how it is checked before anything ships", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#a3a3a3", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 201003, "version": 1, "versionNonce": 201004, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

