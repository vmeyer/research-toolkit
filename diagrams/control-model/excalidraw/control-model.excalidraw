    { "type": "text", "id": "b_depth_bar_t", "x": 75, "y": 186, "width": 530, "height": 20, "text": "quick   →   standard   →   deep      (search breadth)", "originalText": "quick   →   standard   →   deep      (search breadth)", "fontSize": 15, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 201014, "version": 1, "versionNonce": 201015, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "b_depth_bar", "lineHeight": 1.25 },
