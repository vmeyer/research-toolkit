    { "type": "rectangle", "id": "b_assur_bar", "x": 700, "y": 172, "width": 460, "height": 46, "strokeColor": "#fbbf24", "backgroundColor": "#4a3800", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 201022, "version": 1, "versionNonce": 201023, "isDeleted": false, "groupIds": [], "boundElements": [{"id": "b_assur_bar_t", "type": "text"}], "link": null, "locked": false, "roundness": {"type": 3} },
    { "type": "text", "id": "b_assur_bar_t", "x": 715, "y": 186, "width": 430, "height": 20, "text": "standard   →   high      (evidence rigor)", "originalText": "standard   →   high      (evidence rigor)", "fontSize": 15, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 201024, "version": 1, "versionNonce": 201025, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "b_assur_bar", "lineHeight": 1.25 },
