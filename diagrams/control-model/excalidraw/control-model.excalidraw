    { "type": "text", "id": "b_claims_t", "x": 76, "y": 344, "width": 590, "height": 182, "text": "claims.jsonl   ·   one atomic claim per line\n\n{\"id\":\"c1\",\"type\":\"fact\",\"text\":\"…\",\"sources\":[\"s1\",\"s2\"]}\n{\"id\":\"c2\",\"type\":\"inference\",\"text\":\"…\",\"sources\":[\"s3\"]}\n{\"id\":\"c3\",\"type\":\"recommendation\",\"text\":\"…\",\"sources\":[\"s1\",\"s4\"]}\n{\"id\":\"c4\",\"type\":\"gap\",\"text\":\"unresolved: …\"}", "originalText": "claims.jsonl   ·   one atomic claim per line\n\n{\"id\":\"c1\",\"type\":\"fact\",\"text\":\"…\",\"sources\":[\"s1\",\"s2\"]}\n{\"id\":\"c2\",\"type\":\"inference\",\"text\":\"…\",\"sources\":[\"s3\"]}\n{\"id\":\"c3\",\"type\":\"recommendation\",\"text\":\"…\",\"sources\":[\"s1\",\"s4\"]}\n{\"id\":\"c4\",\"type\":\"gap\",\"text\":\"unresolved: …\"}", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 201042, "version": 1, "versionNonce": 201043, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.5 },
