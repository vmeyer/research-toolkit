    { "type": "text", "id": "b_ec_h", "x": 60, "y": 288, "width": 900, "height": 24, "text": "Every step emits a machine-readable evidence contract — two sidecar files", "originalText": "Every step emits a machine-readable evidence contract — two sidecar files", "fontSize": 18, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 201030, "version": 1, "versionNonce": 201031, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

